# =============================================================================
# DevLake Demo Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values.
#
# REQUIRED:
#   ENCRYPTION_SECRET — Generate with:
#     openssl rand -base64 2000 | tr -dc 'A-Z' | fold -w 128 | head -n 1
#
# OPTIONAL (for setup script):
#   GITHUB_PAT        — GitHub PAT with scopes: repo, read:org, read:user
#   GITHUB_ORG        — GitHub org slug (enables Copilot connection)
#
# =============================================================================

# --- DevLake Core (required) -------------------------------------------------

# Database connection (no need to change for docker-compose default)
DB_URL=mysql://merico:merico@mysql:3306/lake?charset=utf8mb4&parseTime=True&loc=UTC

# Encryption key for stored secrets (PATs, passwords).
# Generate: openssl rand -base64 2000 | tr -dc 'A-Z' | fold -w 128 | head -n 1
ENCRYPTION_SECRET=

# --- Docker Image Overrides (optional) ---------------------------------------

# Default: upstream Apache images. Override for DevExpGBB fork:
#   IMAGE_REPO=ghcr.io/devexpgbb
#   IMAGE_TAG=latest
# IMAGE_REPO=apache
# IMAGE_TAG=latest

# --- Port Overrides (optional) -----------------------------------------------

# DEVLAKE_PORT=8080
# CONFIG_UI_PORT=4000
# GRAFANA_PORT=3002
# MYSQL_PORT=3306

# --- Setup Script Configuration (optional) -----------------------------------

# GitHub PAT for the setup script (repo, read:org, read:user scopes).
# For Copilot dashboards, also need: manage_billing:copilot
# GITHUB_PAT=

# GitHub organization slug. If provided, enables Copilot connection.
# GITHUB_ORG=

# Comma-separated repos to collect. Default: apache/incubator-devlake
# REPOS=apache/incubator-devlake

# DevLake project name. Default: DevLake Demo
# PROJECT_NAME=DevLake Demo
